[Unit]
Description=ADE Control Plane raspberry-local runner
After=network.target

[Service]
Type=simple
User=ade-runner
Group=ade-runner
RuntimeDirectory=ade-control-plane-runner
RuntimeDirectoryMode=0750
UMask=0007
EnvironmentFile=/etc/ade-control-plane-runner/runner.env
WorkingDirectory=/srv/apps/ade-control-plane
ExecStart=/srv/apps/ade-control-plane/packages/host-runner/node_modules/.bin/tsx /srv/apps/ade-control-plane/runner/server.ts
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/ade-workspaces /run/ade-control-plane-runner

[Install]
WantedBy=multi-user.target
