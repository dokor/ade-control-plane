# Install with mode 0440 under /etc/sudoers.d and validate with visudo.
# The root-owned host bootstrap validates the requested main-history commit and
# delegates to that revision's reviewed deploy/bin/deploy implementation. Do not
# grant this account sudo/docker access beyond this command.
github-runner ALL=(root) NOPASSWD: /usr/local/sbin/ade-control-plane-deploy
