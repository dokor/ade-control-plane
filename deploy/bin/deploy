#!/usr/bin/env bash
set -Eeuo pipefail

readonly APP_DIR="/srv/apps/ade-control-plane"
readonly COMPOSE_FILE="${APP_DIR}/compose.yaml"
readonly ENV_FILE="${ADE_CONTROL_PLANE_ENV_FILE:-/srv/configs/ade-control-plane/.env.prod}"
readonly DEPLOYED_SHA_FILE="/var/lib/ade-control-plane/deployed-sha"
readonly HEALTH_TIMEOUT_SECONDS=120

die() {
  printf 'ade-control-plane deploy: %s\n' "$1" >&2
  exit 1
}

wait_healthy() {
  local service="$1"
  local container_id status
  for _ in $(seq 1 "$HEALTH_TIMEOUT_SECONDS"); do
    container_id="$("${compose[@]}" ps -q "$service")"
    if [[ -n "$container_id" ]]; then
      status="$(docker inspect --format '{{.State.Health.Status}}' "$container_id" 2>/dev/null || true)"
      if [[ "$status" == "healthy" ]]; then
        return 0
      fi
    fi
    sleep 1
  done
  "${compose[@]}" ps >&2 || true
  "${compose[@]}" logs --tail=200 "$service" >&2 || true
  die "$service did not become healthy"
}

record_deployed_sha() {
  local service container_id image_id digest history=""
  install -d -o root -g root -m 0755 "$(dirname "$DEPLOYED_SHA_FILE")"
  # Capture the actual running digests, including an unchanged runtime, for rollback/retention.
  for service in dashboard worker; do
    container_id="$("${compose[@]}" ps -q "$service")"
    if [[ -n "$container_id" ]]; then
      image_id="$(docker inspect --format '{{.Image}}' "$container_id")"
      digest="$(docker image inspect --format '{{join .RepoDigests ","}}' "$image_id")"
      history+="$(printf '%s\t%s\t%s' "$requested_sha" "$service" "$digest")"$'\n'
    fi
  done
  printf '%s' "$history" >> /var/lib/ade-control-plane/image-history.tsv
  install -o root -g root -m 0644 <(printf '%s\n' "$requested_sha") "$DEPLOYED_SHA_FILE"
}

[[ "$(id -u)" -eq 0 ]] || die "must run as root"
[[ "$#" -eq 3 || ( "$#" -eq 4 && "$4" == "--rollback" ) || ( "$#" -eq 2 && "$2" == "--local" ) ]] || die "usage: deploy <SHA> <dashboard@digest> <worker@digest> [--rollback] | deploy <SHA> --local"
local_build=false
if [[ "$#" -eq 2 ]]; then local_build=true; fi

readonly requested_sha="$1"
[[ "$requested_sha" =~ ^[0-9a-fA-F]{40}$ ]] || die "commit SHA is invalid"
[[ -d "$APP_DIR/.git" && -f "$COMPOSE_FILE" ]] || die "deployment checkout is incomplete"
[[ -f "$ENV_FILE" ]] || die "production environment file is missing"

previous_sha=""
if [[ -f "$DEPLOYED_SHA_FILE" ]]; then
  previous_sha="$(tr -d '[:space:]' < "$DEPLOYED_SHA_FILE")"
fi

cd "$APP_DIR"

[[ -z "$(git status --porcelain)" ]] || die "deployment checkout is dirty"
readonly remote_url="$(git remote get-url origin 2>/dev/null || true)"
case "$remote_url" in
  git@github.com:dokor/ade-control-plane.git|https://github.com/dokor/ade-control-plane.git|ssh://git@github.com/dokor/ade-control-plane.git) ;;
  *) die "origin is not the allow-listed GitHub repository" ;;
esac

git fetch --quiet --no-tags origin "$requested_sha" || die "could not fetch requested commit"
git cat-file -e "${requested_sha}^{commit}" || die "requested object is not a commit"
if [[ "$#" -eq 3 && "$previous_sha" =~ ^[0-9a-fA-F]{40}$ && "$previous_sha" != "$requested_sha" ]] \
  && git cat-file -e "${previous_sha}^{commit}" 2>/dev/null \
  && ! git merge-base --is-ancestor "$previous_sha" "$requested_sha"; then
  die "release is older than or diverges from production; an explicit manual rollback is required"
fi

# Use the exact validated revision's shared classifier, including accumulated
# changes since the last successful production release (not just HEAD^).
if git cat-file -e "$requested_sha:deploy/bin/deployment-scope" 2>/dev/null; then
  deployment_scope="$(bash <(git show "$requested_sha:deploy/bin/deployment-scope") scope "$previous_sha" "$requested_sha")"
  migration_changed="$(bash <(git show "$requested_sha:deploy/bin/deployment-scope") migrations "$previous_sha" "$requested_sha")"
elif "$local_build"; then
  # A reviewed pre-cutover revision can still be rebuilt during manual rollback.
  deployment_scope=full
  migration_changed=true
else
  die "pre-cutover revision requires the explicit manual local-build rollback"
fi

git checkout --detach --force "$requested_sha" >/dev/null || die "could not select requested commit"

printf 'deployment scope: %s\n' "$deployment_scope"
compose=(docker compose --env-file "$ENV_FILE" --project-directory "$APP_DIR" -f "$COMPOSE_FILE")

if [[ "$deployment_scope" == "none" ]]; then
  record_deployed_sha
  printf 'no application changes; recorded %s\n' "$requested_sha"
  exit 0
fi

"${compose[@]}" config --quiet || die "Compose configuration is invalid"
"${compose[@]}" up -d postgres || die "PostgreSQL could not start"
wait_healthy postgres

services=()
case "$deployment_scope" in
  full) services=(dashboard worker) ;;
  dashboard) services=(dashboard) ;;
  worker) services=(worker) ;;
  *) die "unknown deployment scope" ;;
esac

if "$local_build"; then
  # Explicit operator-only outage fallback. Never selected by normal CI deployment.
  export ADE_DASHBOARD_IMAGE=ade-control-plane-dashboard:local
  export ADE_WORKER_IMAGE=ade-control-plane-worker:local
  "${compose[@]}" build "${services[@]}" || die "manual local build failed"
else
  [[ "$2" =~ ^ghcr\.io/dokor/ade-control-plane-dashboard@sha256:[0-9a-f]{64}$ ]] || die "invalid dashboard image digest"
  [[ "$3" =~ ^ghcr\.io/dokor/ade-control-plane-worker@sha256:[0-9a-f]{64}$ ]] || die "invalid worker image digest"
  export ADE_DASHBOARD_IMAGE="$2"
  export ADE_WORKER_IMAGE="$3"
  "${compose[@]}" pull "${services[@]}" || die "immutable image pull failed; no automatic local fallback"
  for service in "${services[@]}"; do
    image="$ADE_WORKER_IMAGE"; [[ "$service" != dashboard ]] || image="$ADE_DASHBOARD_IMAGE"
    expected="$(bash deploy/bin/deployment-scope key "$service" "$requested_sha")"
    actual="$(docker image inspect --format '{{index .Config.Labels "org.ade.source-key"}}' "$image")"
    [[ "$actual" == "$expected" ]] || die "image inputs do not match the validated revision"
  done
fi
if [[ "$migration_changed" == true ]]; then
  "${compose[@]}" run --rm --no-deps --no-build worker node_modules/.bin/tsx apps/worker/src/v0/migrate.ts >/dev/null || die "database migration failed"
fi
"${compose[@]}" up -d --no-build --no-deps "${services[@]}" || die "application containers could not start"
for service in "${services[@]}"; do wait_healthy "$service"; done

record_deployed_sha
printf 'deployed %s\n' "$requested_sha"
