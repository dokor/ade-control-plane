# ADE Control Plane example configuration
#
# Copy to a local .env only when the corresponding implementation exists.
# Never commit real secret values.

NODE_ENV=production

# Public Dashboard URL behind the reverse proxy.
DASHBOARD_PUBLIC_URL=https://ade.example.com

# PostgreSQL
POSTGRES_DB=ade_control_plane
POSTGRES_USER=ade_control_plane
# Prefer runtime secret files/Compose secrets for the real password.
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
DATABASE_URL_FILE=/run/secrets/database_url

# Global scheduler
SCHEDULER_DEFAULT_PRIORITY=50
SCHEDULER_GLOBAL_MODE=paused

# Quota policy defaults
QUOTA_THROTTLED_PERCENT=70
QUOTA_DRAINING_PERCENT=85
QUOTA_BLOCKED_PERCENT=95

# Runner
RUNNER_ID=raspberry-local
RUNNER_TRANSPORT=local
RUNNER_ENDPOINT=http://host.docker.internal:4711
RUNNER_AUTH_SECRET_FILE=/run/secrets/runner_auth_secret
RUNNER_REQUEST_TTL_SECONDS=30

# Dashboard authentication
# Exact provider/session mechanism will be finalized by issue #7/#10.
DASHBOARD_SESSION_SECRET_FILE=/run/secrets/dashboard_session_secret

# GitHub integration
# Prefer GitHub App installation credentials in the final implementation.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github_app_private_key
GITHUB_WEBHOOK_SECRET_FILE=/run/secrets/github_webhook_secret
GITHUB_ALLOWED_ACTOR_IDS=

# Provider/Codex
# The provider credential should live only in the component that needs it.
CODEX_CREDENTIAL_REF=codex-account-main

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
