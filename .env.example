# ADE Control Plane example configuration
#
# Copy to a local .env only when the corresponding implementation exists.
# Never commit real secret values.

NODE_ENV=production

# Public Dashboard URL behind the reverse proxy.
DASHBOARD_PUBLIC_URL=https://ade.example.com

# PostgreSQL
POSTGRES_DB=ade_control_plane
POSTGRES_USER=ade_control_plane
# Prefer runtime secret files/Compose secrets for the real password.
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
DATABASE_URL_FILE=/run/secrets/database_url
# Local integration tests may point to a disposable PostgreSQL database.
TEST_DATABASE_URL=

# Global scheduler
SCHEDULER_DEFAULT_PRIORITY=50
SCHEDULER_GLOBAL_MODE=paused

# Quota policy defaults
QUOTA_THROTTLED_PERCENT=70
QUOTA_DRAINING_PERCENT=85
QUOTA_BLOCKED_PERCENT=95
QUOTA_PROVIDER=openai

# Local Raspberry runner
# MVP transport is a Unix Domain Socket created by the host runner and narrowly
# bind-mounted into the worker container.
RUNNER_ID=raspberry-local
RUNNER_TRANSPORT=unix
RUNNER_SOCKET_PATH=/run/ade-control-plane-runner/runner.sock
RUNNER_AUTH_SECRET_FILE=/run/secrets/runner_auth_secret
RUNNER_REQUEST_TTL_SECONDS=30

# Dashboard authentication
# Application-layer sessions: an HMAC-signed, HttpOnly, SameSite=Lax cookie.
# Generate the secret with: openssl rand -hex 32
DASHBOARD_SESSION_SECRET_FILE=/run/secrets/dashboard_session_secret
# scrypt hash of the operator password, produced by:
#   pnpm --filter @ade-control-plane/dashboard exec tsx scripts/hash-password.ts
DASHBOARD_PASSWORD_HASH_FILE=/run/secrets/dashboard_password_hash
DASHBOARD_OPERATOR_REF=operator
DASHBOARD_SESSION_TTL_MINUTES=720
# Controlled polling interval for server-rendered reads.
DASHBOARD_REFRESH_SECONDS=15

# GitHub integration
# A GitHub App installation, not a global PAT: repo-scoped, minimal permissions,
# short-lived installation tokens, signed webhooks.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github_app_private_key
# Without this secret the webhook endpoint answers 503 rather than accepting
# deliveries it cannot verify.
GITHUB_WEBHOOK_SECRET_FILE=/run/secrets/github_webhook_secret
# Numeric GitHub user IDs allowed to issue @ade commands. Logins can be renamed;
# IDs cannot, so the allow-list is keyed on IDs.
GITHUB_ALLOWED_ACTOR_IDS=
# Optional: restrict accepted deliveries to specific installation IDs.
GITHUB_ALLOWED_INSTALLATION_IDS=

# Provider/Codex
# The provider credential should live only in the component that needs it.
CODEX_CREDENTIAL_REF=codex-account-main

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
