# ADE Control Plane example configuration
#
# Copy this template outside the checkout for production, for example to
# /srv/configs/ade-control-plane/.env.prod. Never commit real secret values.

NODE_ENV=production

# Compose host paths (keep project repositories and Git credentials outside the
# application checkout when possible).
DASHBOARD_BIND_PORT=3000
V0_PROJECTS_HOST=./data/projects
V0_GIT_HOME_HOST=./data/git-home
SECRETS_DIR=./secrets
# Numeric GID of the host `ade-secrets` group. File-backed Compose secrets are
# bind-mounted, so non-root containers need this dedicated read-only group.
SECRETS_GID=replace-with-ade-secrets-group-gid

# Public Dashboard URL behind the reverse proxy.
DASHBOARD_PUBLIC_URL=https://ade.example.com
# DNS host configured by the existing Traefik `proxy` network.
DASHBOARD_PUBLIC_HOST=ade.example.com

# PostgreSQL
POSTGRES_DB=ade_control_plane
POSTGRES_USER=ade_control_plane
# Prefer runtime secret files/Compose secrets for the real password.
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
DATABASE_URL_FILE=/run/secrets/database_url
# Local integration tests may point to a disposable PostgreSQL database.
TEST_DATABASE_URL=

# Global scheduler
SCHEDULER_DEFAULT_PRIORITY=50
SCHEDULER_GLOBAL_MODE=paused

# Quota policy defaults
QUOTA_THROTTLED_PERCENT=70
QUOTA_DRAINING_PERCENT=85
QUOTA_BLOCKED_PERCENT=95
QUOTA_PROVIDER=openai

# Dashboard authentication
# Application-layer sessions: an HMAC-signed, HttpOnly, SameSite=Lax cookie.
# Generate the secret with: openssl rand -hex 32
DASHBOARD_SESSION_SECRET_FILE=/run/secrets/dashboard_session_secret
# scrypt hash of the operator password, produced by:
#   pnpm --filter @ade-control-plane/dashboard exec tsx scripts/hash-password.ts
DASHBOARD_PASSWORD_HASH_FILE=/run/secrets/dashboard_password_hash
DASHBOARD_OPERATOR_REF=operator
DASHBOARD_SESSION_TTL_MINUTES=720
# Controlled polling interval for server-rendered reads.
DASHBOARD_REFRESH_SECONDS=300

# GitHub integration
# A GitHub App installation, not a global PAT: repo-scoped, minimal permissions,
# short-lived installation tokens, signed webhooks.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github_app_private_key
# Without this secret the webhook endpoint answers 503 rather than accepting
# deliveries it cannot verify.
GITHUB_WEBHOOK_SECRET_FILE=/run/secrets/github_webhook_secret
# Numeric GitHub user IDs allowed to issue @ade commands. Logins can be renamed;
# IDs cannot, so the allow-list is keyed on IDs.
GITHUB_ALLOWED_ACTOR_IDS=
# Optional: restrict accepted deliveries to specific installation IDs.
GITHUB_ALLOWED_INSTALLATION_IDS=

# Provider/Codex
# V0 uses one allow-listed local checkout per registered project. Each project
# stores configuration.v0.checkout as a relative path under this root.
V0_PROJECT_ROOT=/srv/ade-projects
# Explicit provider selection. The lifecycle remains ADE/GitHub-owned for both.
V0_AGENT_PROVIDER=codex
CODEX_EXECUTABLE=codex
CLAUDE_EXECUTABLE=claude
# The worker ships a pinned ADE CLI. The selected profile maps to the project's
# ade.config profile and bounds the generated context pack.
ADE_EXECUTABLE=ade
V0_ADE_PROFILE=normal
V0_TASK_TIMEOUT_SECONDS=3600
V0_WORKER_IDLE_SECONDS=2
# Full GitHub reconciliation safety net; event-driven wakeups handle normal changes.
V0_FULL_RECONCILE_SECONDS=900
V0_HEARTBEAT_SECONDS=30
# Prefer a dedicated API key file. The worker passes it only to the Codex child,
# never to Git commands. Saved Codex CLI auth under CODEX_HOME is also supported.
CODEX_API_KEY_FILE=/run/secrets/codex_api_key
# Required only when V0_AGENT_PROVIDER=claude-code.
ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key
CODEX_HOME=/home/ade-worker/.codex
# Compose always starts Codex App Server on the worker's private loopback
# interface. No URL, listener or token is configured from this file.
CODEX_CREDENTIAL_REF=codex-account-main
# Separate home containing only Git configuration/SSH material for push.
V0_GIT_HOME=/home/ade-git

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
