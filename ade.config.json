{
  "ignore": [
    ".env*",
    "dist/**",
    "node_modules/**",
    ".next/**",
    "coverage/**",
    "outputs/**"
  ],
  "sensitive": [
    ".env*",
    "**/*.pem",
    "**/*.key",
    "**/secrets.*"
  ],
  "tools": [
    "typecheck",
    "test"
  ],
  "rules": [
    {
      "id": "development/service-size",
      "severity": "warn",
      "appliesTo": [
        "**/*Executor.ts",
        "**/*Orchestrator.ts"
      ]
    }
  ],
  "packs": [
    "development"
  ],
  "profiles": {
    "ci": {
      "mode": "deterministic",
      "context": "compact",
      "privacy": "strict"
    },
    "po-pm": {
      "mode": "assisted",
      "context": "compact",
      "allowProvider": true,
      "tokenBudget": 12000,
      "privacy": "strict"
    },
    "normal": {
      "mode": "assisted",
      "context": "compact",
      "allowProvider": true,
      "tokenBudget": 12000,
      "privacy": "strict"
    },
    "architecture-maintainability": {
      "mode": "assisted",
      "context": "full",
      "allowProvider": true,
      "tokenBudget": 10000,
      "privacy": "strict"
    },
    "security": {
      "mode": "assisted",
      "context": "compact",
      "allowProvider": true,
      "tokenBudget": 8000,
      "privacy": "strict"
    },
    "performance-resource-lifecycle": {
      "mode": "assisted",
      "context": "full",
      "allowProvider": true,
      "tokenBudget": 10000,
      "privacy": "strict"
    },
    "final-quality": {
      "mode": "assisted",
      "context": "compact",
      "allowProvider": true,
      "tokenBudget": 8000,
      "privacy": "strict"
    }
  },
  "context": {
    "docsDir": "docs",
    "adrDir": "docs/DECISIONS",
    "outputDir": "outputs/context"
  },
  "output": {
    "formats": [
      "markdown",
      "json"
    ]
  },
  "issueLifecycle": {
    "enrichment": {
      "enabled": true,
      "profile": "po-pm",
      "minimumAcceptanceCriteria": 3
    },
    "priority": 50,
    "retryPolicy": "reconcile-first",
    "deliveryPlan": {
      "implementationProfile": "normal",
      "reviewProfiles": [
        "architecture-maintainability",
        "security",
        "performance-resource-lifecycle",
        "final-quality"
      ],
      "validationRuleIds": [
        "development/service-size"
      ],
      "maxCorrectionAttempts": 1,
      "requireHumanApprovalBeforePublish": false
    }
  }
}
